# Google AI Studio Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OCR Configuration (easyocr, paddleocr, or tesseract)
DEFAULT_OCR_ENGINE=easyocr
TESSERACT_CMD=

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Storage
DATA_DIR=data
DATABASE_URL=sqlite:///data/invoice_intelligence.db
